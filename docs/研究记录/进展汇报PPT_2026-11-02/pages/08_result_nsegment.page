      fontSize: 12.5
  - type: line
    bounds: [654, 222, 266, 0]
    border: {style: solid, width: 0.75, color: "$hairline"}
  - type: text
    bounds: [654, 238, 266, 120]
    content:
      text: |
        <p><strong>(c) t*(N₀)</strong></p>
        <p style="margin-top:4px;color:$soft">分离时刻随按压力增加而提前，近似幂律。</p>
      style: $body
      fontSize: 12.5
  - type: line
    bounds: [654, 364, 266, 0]
    border: {style: solid, width: 0.75, color: "$hairline"}
  - type: text
    bounds: [654, 380, 266, 96]
    content:
      text: |
        <p><strong>(d) I₂nd(N₀)</strong></p>
        <p style="margin-top:4px;color:$soft">二阶滑移量对 N₀ 更敏感，是辨识 N₀ 的观测量。</p>
      style: $body
      fontSize: 12.5
  - type: shape
    bounds: [36, 512, 884, 0.1]
    shape: rect
    fill: {type: solid, color: "$graybg"}
    border: {style: none, width: 0, color: "$graybg"}
