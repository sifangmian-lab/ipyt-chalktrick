background:
  type: gradient
  gradientType: linear
  angle: 125
  stops:
    - {position: 0, color: "#FEF2E8"}
    - {position: 0.55, color: "#DBEDFE"}
    - {position: 1, color: "#DEF8E9"}
elements:
  - type: text
    bounds: [64, 46, 560, 24]
    content:
      text: "IPT 2023 · stick-slip · 粉笔—黑板断续虚线"
      style: $small
      letterSpacing: 2
  - type: text
    bounds: [64, 92, 620, 140]
    content:
      text: |
        <p>粉笔虚线（ChalkTrick）</p>
        <p><span style="color:$primary">研究进展汇报</span></p>
      style: $pageTitle
      fontSize: 45
      lineHeight: 1.25
  - type: text
    bounds: [64, 246, 560, 52]
    content:
      text: "从 IPT 赛题到第一阶段模型与实验体系：四周进展、评审结论与下一步"
      style: $body
      color: "$soft"
  - type: line
    bounds: [64, 322, 208, 0]
    border: {style: solid, width: 1.5, color: "$ink"}
  - type: text
    bounds: [64, 342, 560, 78]
    content:
      text: |
        <p>池亦天 · 物理学院</p>
        <p>2026-11-02 · 仓库 sifangmian-lab/ipyt-chalktrick</p>
        <p style="margin-top:6px"><span style="color:$blue">develop 分支 · 基于 2026-10-24 评审与 2026-10-27 S4v1 归档</span></p>
      style: $body
      fontSize: 13.5
  - type: shape
    bounds: [640, 92, 256, 340]
    shape: rect
    fill: {type: solid, color: "$almond"}
    border: {style: solid, width: 1.5, color: "$ink"}
  - type: line
    bounds: [664, 150, 208, 0]
    border: {style: solid, width: 2, color: "$soft"}
  - type: line
    bounds: [664, 196, 208, 0]
    border: {style: dash, width: 3, color: "$blue"}
  - type: line
    bounds: [664, 242, 208, 0]
    border: {style: dash, width: 3, color: "$blue"}
  - type: line
    bounds: [664, 288, 208, 0]
    border: {style: dash, width: 3, color: "$blue"}
  - type: text
    bounds: [664, 316, 208, 20]
    content:
      text: "v → 画线方向"
      style: $caption
      align: [center, top]
  - type: line
    bounds: [664, 366, 208, 0]
    border: {style: solid, width: 1, color: "$ink"}
  - type: text
    bounds: [664, 378, 208, 40]
    content:
      text: "压痕 p / 间隔 s / 沟槽 g / 痕宽 w"
      style: $caption
      align: [center, top]
  - type: line
    bounds: [700, 128, 0, 54]
    border: {style: solid, width: 1.5, color: "$ink"}
  - type: line
    bounds: [700, 128, 40, -22]
    border: {style: solid, width: 1.5, color: "$ink"}
  - type: text
    bounds: [712, 96, 40, 22]
    content:
      text: "N"
      style: $body
      color: "$blue"
      bold: true
