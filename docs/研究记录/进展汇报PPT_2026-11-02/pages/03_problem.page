      style: "$pageTitle"
      wrap: false
      text: 官方题目驱动：连续运动为何留下虚线——复现、辨识、普遍性、反演
  - elementId: lhead
    elementType: text
    bounds: [26, 88, 270, 22]
    content:
      fontSize: 14
      bold: true
